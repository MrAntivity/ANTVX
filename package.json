{
  "name": "antvx-studio",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "node scripts/build-site.mjs",
    "test": "node --test tests/*.test.js",
    "test:rules": "firebase emulators:exec --project demo-antvx --only firestore,storage 'node --test tests/rules.integration.js'",
    "preview": "python3 -m http.server 8000",
    "test:browser": "node tests/browser-check.mjs",
    "test:e2e": "firebase emulators:exec --project demo-antvx --only auth,firestore,storage 'node tests/portal-e2e.mjs'"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "^5.0.0",
    "firebase": "^12.0.0",
    "firebase-tools": "^15.0.0",
    "@playwright/test": "^1.58.0"
  }
}
